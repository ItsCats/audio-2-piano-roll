# ---- Frontend (Vite; exposed to the browser — never put secrets here) ----
# Default URL of the optional processing server (users can also set it in Settings)
VITE_PROCESSING_URL=

# ---- Netlify Functions (server-side only; set in Netlify → Site configuration → Environment variables) ----
# Shared secret used to mint short-lived tokens for the processing server.
# Must equal SHARED_SECRET on the processing server. Generate: openssl rand -hex 32
PROCESSING_SHARED_SECRET=
# Optional extra origins (comma-separated) allowed to request tokens, e.g. a custom domain
EXTRA_ALLOWED_ORIGINS=
