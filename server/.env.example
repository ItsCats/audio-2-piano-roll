# Must equal PROCESSING_SHARED_SECRET configured on Netlify (generate with: openssl rand -hex 32)
SHARED_SECRET=
# Comma-separated list of web origins allowed to call this server
ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:5173
# Local development only: accept requests without a token
ALLOW_ANONYMOUS=0
ENABLE_YOUTUBE=1
ENABLE_SEPARATION=1
MAX_UPLOAD_MB=200
MAX_DURATION_SEC=1200
JOBS_PER_HOUR_PER_IP=20
# SCNet separation: model path (Docker image bakes it in), threads per job (0 = all cores)
# SCNET_MODEL=/srv/models/scnet.int8.onnx
SCNET_THREADS=0
