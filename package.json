{
  "name": "pianovision",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn audio, YouTube and MIDI into an interactive falling-note piano roll with realistic piano playback and video export.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "copy:model": "node scripts/copy-model.mjs",
    "build:samples": "python3 scripts/build-samples.py",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mediabunny/aac-encoder": "^1.65.2",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tonejs/midi": "^2.0.28",
    "idb": "^8.0.4",
    "lucide-react": "^1.71.0",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@spotify/basic-pitch": "^1.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tensorflow/tfjs": "^3.21.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
