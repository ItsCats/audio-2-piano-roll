{
  "name": "piano2vision",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Turn audio, YouTube and MIDI into an interactive falling-note piano roll with realistic piano playback and video export.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "copy:model": "node scripts/copy-model.mjs",
    "build:samples": "python3 scripts/build-samples.py",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:specialist": "node tests/e2e/specialist.mjs",
    "test:e2e:export": "node tests/e2e/export-sync.mjs",
    "test:e2e:keys": "node tests/e2e/studio-keys.mjs",
    "test:e2e:privacy": "node tests/e2e/privacy.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/great-vibes": "5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@mediabunny/aac-encoder": "^1.65.2",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tonejs/midi": "^2.0.28",
    "fflate": "0.8.3",
    "idb": "^8.0.4",
    "jspdf": "4.2.1",
    "lucide-react": "^1.71.0",
    "mediabunny": "^1.65.2",
    "onnxruntime-web": "1.31.1",
    "opensheetmusicdisplay": "2.2.1",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "svg2pdf.js": "2.9.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@spotify/basic-pitch": "^1.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tensorflow/tfjs": "^3.21.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
